[Unit]
Description=Stations Directus (docker compose, waits for Tailscale IP)
After=docker.service tailscaled.service network-online.target
Requires=docker.service
Wants=tailscaled.service network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=sandbox
WorkingDirectory=/home/sandbox/stations/directus
ExecStartPre=/bin/sh -c 'for i in $(seq 1 60); do ip -4 addr | grep -q 100.69.92.42 && exit 0; sleep 2; done; exit 1'
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose stop

[Install]
WantedBy=multi-user.target
